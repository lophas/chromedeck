{
  "manifest_version": 3,
  "name": "ChromeDeck keyboard",
  "version": "1.1",
  "description": "Opens Android's on-screen keyboard when you tap a text field in ChromeDeck.",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }]
}
