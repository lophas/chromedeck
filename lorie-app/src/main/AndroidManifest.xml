<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name="com.termux.x11.DesktopChromeApp"
        tools:replace="android:name"
        android:icon="@mipmap/lorie_ic_launcher"
        android:label="@string/lorie_app_name"
        android:roundIcon="@mipmap/lorie_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/LorieAppTheme"
        android:hardwareAccelerated="true">
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="false" />
        <!-- Termux:X11 exports these for its command-line tools. This app has none, and
             any installed app could otherwise change preferences or stop the session. -->
        <receiver android:name="com.termux.x11.LoriePreferences$Receiver"
            android:exported="false" tools:replace="android:exported" />
        <receiver android:name="com.termux.x11.LorieApp$Receiver"
            android:exported="false" tools:replace="android:exported" />
        <activity
            android:name="com.termux.x11.PhoneScreenOffActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:taskAffinity=".PhoneScreenOff"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="false" />
        <service
            android:name="com.termux.x11.EmbeddedX11Service"
            android:process=":xserver"
            android:exported="false" />
    </application>
</manifest>
