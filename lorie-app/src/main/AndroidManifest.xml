<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name="com.termux.x11.DesktopChromeApp"
        tools:replace="android:name"
        android:icon="@mipmap/lorie_ic_launcher"
        android:label="@string/lorie_app_name"
        android:roundIcon="@mipmap/lorie_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/LorieAppTheme"
        android:hardwareAccelerated="true">
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="false" />
        <!-- Termux:X11 exports these for its command-line tools. This app has none, and
             any installed app could otherwise change preferences or stop the session. -->
        <receiver android:name="com.termux.x11.LoriePreferences$Receiver"
            android:exported="false" tools:replace="android:exported" />
        <receiver android:name="com.termux.x11.LorieApp$Receiver"
            android:exported="false" tools:replace="android:exported" />
        <activity
            android:name="com.termux.x11.LauncherActivity"
            android:icon="@mipmap/lorie_ic_launcher"
            android:roundIcon="@mipmap/lorie_ic_launcher_round"
            android:label="@string/lorie_app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=".Launcher"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.termux.x11.PhoneScreenOffActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:taskAffinity=".PhoneScreenOff"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="false" />
        <service
            android:name="com.termux.x11.PhoneScreenOffTile"
            android:icon="@drawable/dc_ic_launcher_monochrome"
            android:label="@string/lorie_notification_phone_screen_off"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity android:name="com.termux.x11.MainActivity" tools:node="merge">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.termux.x11.EmbeddedX11Service"
            android:process=":xserver"
            android:exported="false" />
    </application>
</manifest>
