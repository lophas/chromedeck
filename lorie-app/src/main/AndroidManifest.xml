<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name="com.termux.x11.DesktopChromeApp"
        tools:replace="android:name"
        android:icon="@mipmap/lorie_ic_launcher"
        android:label="@string/lorie_app_name"
        android:roundIcon="@mipmap/lorie_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/LorieAppTheme"
        android:hardwareAccelerated="true">
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="false" />
        <service
            android:name="com.termux.x11.EmbeddedX11Service"
            android:process=":xserver"
            android:exported="false" />
    </application>
</manifest>
